{
  "name": "llms-full-unbind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for llms-full-unbind packages",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/markdown": "^8.0.0",
    "@ota-meshi/eslint-plugin": "^0.19.0",
    "@types/node": "^24.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.0",
    "eslint-plugin-eslint-plugin": "^7.0.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-json-schema-validator": "^6.0.0",
    "eslint-plugin-jsonc": "^3.0.0",
    "eslint-plugin-markdown-links": "^0.9.0",
    "eslint-plugin-markdown-preferences": "^0.42.0",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-node-dependencies": "^2.0.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-yml": "^3.0.0",
    "prettier": "^3.5.3",
    "tsdown": "^0.22.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.56.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "tsc": "tsc -b packages/*",
    "eslint-fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "cover": "pnpm -r run cover",
    "update-resources": "pnpm run build && pnpm -r run update-resources",
    "changeset:version": "changeset version && pnpm run update-resources && git add --all",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ota-meshi/llms-full-unbind.git"
  },
  "author": "Yosuke Ota",
  "funding": "https://github.com/sponsors/ota-meshi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ota-meshi/llms-full-unbind/issues"
  },
  "homepage": "https://github.com/ota-meshi/llms-full-unbind#readme"
}
